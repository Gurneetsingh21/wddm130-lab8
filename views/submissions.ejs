<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="author" content="Gurneet Singh Saini">
    <title>All Orders</title>

    <link href="https://fonts.googleapis.com/css?family=Bilbo+Swash+Caps" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css?family=Kalam" rel="stylesheet">

    <link rel="stylesheet" href="/css/form.css">
</head>

<body>

<nav class="top_menu">
    <ul>

        <li>
            <a href="/">Order Form</a>
        </li>

        <li>
            <a href="/submissions">All Orders</a>
        </li>

        <% if (isAdmin) { %>

            <li>
                Welcome, <%= adminName %>
            </li>

            <li>
                <a href="/logout">Logout</a>
            </li>

        <% } else { %>

            <li>
                <a href="/login">Admin Login</a>
            </li>

        <% } %>

    </ul>
</nav>

<section class="w50">

    <h2>All Orders</h2>

    <% if (submissions.length === 0) { %>

        <p>No orders found.</p>

    <% } else { %>

        <% submissions.forEach(function(order) { %>

            <div class="formData">

                <p>

                    <strong>Name:</strong>
                    <%= order.name %>
                    <br>

                    <strong>Email:</strong>
                    <%= order.email %>
                    <br>

                    <strong>Phone:</strong>
                    <%= order.phone %>
                    <br>

                    <strong>Post Code:</strong>
                    <%= order.postcode %>
                    <br>

                    <strong>Campus:</strong>
                    <%= order.campus %>
                    <br>

                    <strong>Tickets:</strong>
                    <%= order.tickets %>
                    <br>

                    <strong>Lunch:</strong>
                    <%= order.lunch %>
                    <br>

                    <strong>Subtotal:</strong>
                    $<%= order.subtotal.toFixed(2) %>
                    <br>

                    <strong>Tax:</strong>
                    $<%= order.tax.toFixed(2) %>
                    <br>

                    <strong>Total:</strong>
                    $<%= order.total.toFixed(2) %>

                </p>

            </div>

            <hr>

        <% }) %>

    <% } %>

</section>

<div class="clear"></div>

</body>

</html>